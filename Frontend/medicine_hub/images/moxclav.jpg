   profilePicUrl: user?.profile_pic_url,\n            });\n            let elem = document.getElementById('widget-copilot')\n            if (elem) {\n              elem.style.visibility = 'unset';\n            }\n\n        } else {\n            console.log(\"\u003E\u003E\u003E Netmeds: user not logged in\");\n            copilot?.(\"event\", \"unsetUser\");\n            let elem = document.getElementById('widget-copilot')\n            if (elem) {\n               elem.style.visibility = 'hidden';\n            }\n\n        }\n    }, 1500);\n});","_id":"670e41fe99c42dc5c4737f17","name":"Copilot JS","type":"js","sub_type":"inline","compatible_engines":["vue2","react"],"position":"body-bottom","pages":[]},{"url":"https:\u002F\u002Freviews-ratings-widget.jio.com\u002Fnetmeds\u002Fextension.umd.min.js","_id":"6810b88ede9273fe38e336c1","name":"Reviews injection script","type":"js","sub_type":"external","compatible_engines":[],"position":"body-bottom","attributes":{"defer":"defer"},"pages":[{"page_slug":"product","type":"system"}],"__source":{"type":"extension","id":"67ee69dda82470dcf1d11fbd"}},{"url":"https:\u002F\u002Freviews-ratings-widget.jio.com\u002Fnetmeds\u002Fextension.css","_id":"6810b88e76e638988d738216","name":"Reviews injection style","type":"css","sub_type":"external","compatible_engines":[],"position":"head","attributes":{"defer":"defer"},"pages":[{"page_slug":"product","type":"system"}],"__source":{"type":"extension","id":"67ee69dda82470dcf1d11fbd"}},{"url":"https:\u002F\u002Fproduct-stock-notify.extensions.netmeds.tech\u002Fbindings\u002Fproduct-stock-notification\u002Fproduct-stock-notification.umd.min.js","_id":"6891a208a74927a622596f48","name":"prodStockNotify script","type":"js","sub_type":"external","compatible_engines":[],"position":"body-bottom","pages":[],"__source":{"type":"extension","id":"65f84090ab173d790728f3fc"}},{"url":"https:\u002F\u002Fproduct-stock-notify.extensions.netmeds.tech\u002Fbindings\u002Fproduct-stock-notification\u002Fproduct-sto