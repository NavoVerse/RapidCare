        <!--App Tags-->
        <script fdk-hash="669636dd1b5cd5f3729c393f" type="text/javascript" defer="true" id="sentry-script-id"  src="https://browser.sentry-cdn.com/7.28.1/bundle.min.js"></script><script fdk-hash="669636dd0a97961273fe0951" type="text/javascript" >
            function initSentry() {
                try {
                    let ignoreURLs = ["https://www.netmeds.tech/public/","https://store-cdn.fynd.com/"];
                    window.Sentry.init({
                        Vue: window.Vue,
                        dsn: "https://3ec3b9745bc9554db2211245db284407@o71740.ingest.us.sentry.io/4507610668728320",
                        tracesSampleRate: "1.0", // capture 100% errors.
                        environment: "production",
                        release: "v1.0",
                        attachStacktrace: true,
                        beforeSend: (event, hint) => {
                            try {
                                let shouldSend = true;
                                let sourceURL = event.exception.values[0].stacktrace.frames[0].filename;
                                if(ignoreURLs && ignoreURLs.length) {
                                    ignoreURLs.forEach((url) => {
                                        if(sourceURL.includes(url)) {
                                            shouldSend = false;
                                        }
                                    });
                                }
                                if(!shouldSend) {
                                    return null;
                                }
                                return event;
                            } catch(error) {
                                return event;
                            }
                        }
                    });
                    window.Sentry.setTag('x-application-id', "65f562c1504a59a67f529ad4");
                    console.log("sentry initiated");            
                }
                catch(error) {
                    console.log(error, "Sentry Failed to Initialize.");
                }
            }
            if(window && window.Sentry) {
                initSentry();
            } else {
                let sentryCDN = document.querySelectorAll('script[id="sentry-script-id"]')[0];
                sentryCDN.onload = initSentry;
            }
</script><link rel="stylesheet" id="65f562c1504a59a67f529ad4" media="print" onload="this.media='all'"   href=https://seo-extension.extensions.netmeds.tech/bindings/home-config.css fdk-hash="66faa75b42cc35fe29169398"><link rel="stylesheet"   href=https://jioadsweb.akamaized.net/jioads/websdk/default/stable/fynd/JioAdsBindings.css fdk-hash="689c56eeef53276faff02b29"><script fdk-hash="689c56eeef53276faff02b2a" type="text/javascript" id="JioAds_65f562c1504a59a67f529ad4" async="true"  src="https://jioadsweb.akamaized.net/jioads/websdk/default/stable/fynd/jioAds.js"></script><script fdk-hash="689c56eeef53276faff02b2b" type="text/javascript" id="JioAdsV6_65f562c1504a59a67f529ad4" async="true"  src="https://jioadsweb.akamaized.net/jioads/websdk/default/stable/fynd/app-v6.js"></script><script fdk-hash="689c56eeef53276faff02b2c" type="text/javascript" id="JioAdsSwiper_65f562c1504a59a67f529ad4" async="true"  src="https://jioadsweb.akamaized.net/jioads/websdk/default/stable/fynd/swiper.min.js"></script><script fdk-hash="689c56eeef53276faff02b2d" type="text/javascript" id="JioAdsjquery_65f562c1504a59a67f529ad4" async="true"  src="https://jioadsweb.akamaized.net/jioads/websdk/default/stable/fynd/jquery-3.4.1.min.js"></script>
