})(window, document, "script", "copilot", "https://script.copilot.live/v1/copilot.min.js?tkn=cat-x116sy1z");
console.log(">>> Netmeds: Injected");
copilot("init", {});
let elem = document.getElementById('widget-copilot')
if (elem) {
     elem.style.visibility = 'hidden';
      }
FPI.state.user.subscribe(({
    user = ""
}) => {
    setTimeout(() => {
        if (user) {
            console.log(">>> Netmeds: user logged in", user?.user_id);
            let email = user?.emails?.find(val => val?.primary)?.email
            let phone = user?.phone_numbers?.find(val => val?.primary)
            let formattedPhone = phone?.country_code && phone?.phone ? "+" + phone.country_code + phone.phone : "";
            copilot?.("event", "setUser", {
                hostId: user?.user_id,
                name: user?.first_name?.trim() + " " + user?.last_name?.trim(),
                email,
                phone: formattedPhone,
                profilePicUrl: user?.profile_pic_url,
            });
            let elem = document.getElementById('widget-copilot')
            if (elem) {
              elem.style.visibility = 'unset';
            }

        } else {
            console.log(">>> Netmeds: user not logged in");
            copilot?.("event", "unsetUser");
            let elem = document.getElementById('widget-copilot')
            if (elem) {
               elem.style.visibility = 'hidden';
            }

        }
    }, 1500);
});</script><script fdk-hash="6891a208a74927a622596f48" type="text/javascript"  src="https://product-stock-notify.extensions.netmeds.tech/bindings/product-stock-notification/product-stock-notification.umd.min.js"></script><link rel="stylesheet"   href=https://product-stock-notify.extensions.netmeds.tech/bindings/product-stock-notification/product-stock-notification.css fdk-hash="6891a208a74927a622596f49"><script fdk-hash="6891a209a74927a622596f5d" type="text/javascript"  src="https://product-stock-notify.extensions.netmeds.tech/bindings/product-stock-notification/product-stock-notification.umd.min.js"></script><link rel="stylesheet"   href=https://product-stock-notify.extensions.netmeds.tech/bindings/product-stock-notification/product-stock-notification.css fdk-hash="6891a209a74927a622596f5e"><script fdk-hash="689c56eeef53276faff02b28" type="text/javascript" id="JioAdsBinding_65f562c1504a59a67f529ad4" async="true"  src="https://jioadsweb.akamaized.net/jioads/websdk/default/stable/fynd/JioAdsBindings.umd.js"></script>
    </body>
</html>
